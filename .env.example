# Copy this to .env and fill in values.
# VITE_* vars are bundled into the client JS — they are NOT secret.
# Anything you put here is visible to anyone who opens browser DevTools on the deployed site.

# Primary Ethereum mainnet RPC (used when wallet is not on Ethereum)
# Recommended: keyless, CORS-enabled public RPC — nothing to leak
VITE_ETH_RPC=https://ethereum-rpc.publicnode.com

# First fallback if primary is down
VITE_ETH_RPC_BACKUP=https://eth.drpc.org

# Second fallback (optional). If you put a keyed URL (Alchemy/Infura) here,
# LOCK IT in the provider dashboard with a domain allowlist before deploying:
#   - https://dbxen-v2.vercel.app
#   - http://localhost:5173
VITE_ETH_RPC_BACKUP2=
